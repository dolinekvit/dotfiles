# Ghostty configuration
# 静 — matched to the Neovim vague setup.

# Font: GeistMono Nerd Font includes all the file-type / git icons that
# neo-tree and lualine use. The "Mono" variant keeps icons single-width.
font-family = GeistMono Nerd Font Mono
font-size = 14

# Colours: Ghostty's built-in vague palette, the same one Neovim uses, so the
# terminal background matches the editor with no seam at the edges.
theme = Vague

# A little breathing room around the text.
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true

# Cursor
cursor-style = block
cursor-style-blink = false
custom-shader = ~/.config/ghostty/shaders/cursor-smear.glsl

# macOS: let Option work as Alt for keybindings.
macos-option-as-alt = true

# Slightly translucent background (set to 1 for fully opaque).
background-opacity = 0.98

# Keybindings
# cmd+shift+f toggles fullscreen (overrides Ghostty's default end_search).
keybind = cmd+shift+f=toggle_fullscreen
